/*
 * One paired RNA+ATAC sample with cell metadata and per-sample barcode suffixes; membership from RNA.
 * Run from the repository root: nextflow run . -profile test_paired[,local|docker]
 */
includeConfig 'test.config'

params {
    input              = 'tests/data/samplesheet_paired.csv'
    cell_metadata      = 'tests/data/metadata.csv'
    barcode_delimiter  = '_'
    allow_dtype_change = true
    constrain_by       = 'annotation'
    eval_labels        = 'annotation'
}
