/*
 * 10x inputs: a multiome .h5 given for both assays of S1 (split by feature type) and an mtx folder for S2.
 * Run from the repository root: nextflow run . -profile test_10x[,local|docker]
 */
includeConfig 'test.config'

params {
    input       = 'tests/data/samplesheet_10x.csv'
    methods     = 'seacells'
    eval_labels = null
}
