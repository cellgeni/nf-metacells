/*
 * Process defaults. Scheduler kills (exit 130-145, 104, 175) are retried with more memory; other failures stop
 * the task. Farm queues: normal, then long on a retry.
 */
process {
    shell         = ['bash', '-C', '-e', '-u', '-o', 'pipefail']
    cpus          = 1
    memory        = { 4.GB * task.attempt }
    queue         = { task.attempt == 1 ? 'normal' : 'long' }
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 3

    /*
     * GPU-capable processes run on a GPU when --gpu_steps selects their step, which is the last part of the process
     * name in lower case (SCANPY_PCA -> pca, SEACELLS -> seacells). Modules read task.accelerator and never set it.
     * LSF ignores `accelerator`, so the GPU is requested with -gpu (8 GB more GPU memory on each retry) and the
     * container gets the GPU (--nv, --gpus all). gpu_gmem >= 40000 MB keeps jobs off the V100s, which the CUDA 12
     * RAPIDS wheels no longer support.
     */
    withLabel: 'process_gpu' {
        accelerator      = {
            def step = task.process.tokenize(':')[-1].tokenize('_')[-1].toLowerCase()
            def auto = ['pca', 'neighbors', 'lsi', 'spectral', 'seacells', 'hmetacells']
            def steps = params.gpu_steps == 'auto' ? auto : params.gpu_steps.tokenize(',')
            params.gpu_steps == 'all' || step in steps ? 1 : null
        }
        queue            = { task.accelerator ? params.gpuqueue : (task.attempt == 1 ? 'normal' : 'long') }
        clusterOptions   = {
            def gmem = params.gpu_gmem + 8000 * (task.attempt - 1)
            def account = params.costcode ? " -G ${params.costcode}" : ''
            task.accelerator ? "-gpu \"mode=shared:j_exclusive=yes:gmem=${gmem}:num=1\"${account}" : null
        }
        containerOptions = {
            def engine = workflow.containerEngine
            !task.accelerator ? null : engine in ['singularity', 'apptainer'] ? '--nv' : engine == 'docker' ? '--gpus all' : null
        }
    }
}
