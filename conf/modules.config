/*
 * Per-process options: tool arguments built from the pipeline parameters, resources and retries.
 */
process {
    withName: 'ADATA_CONVERT' {
        memory = { 4.GB * task.attempt }
    }

    withName: 'ADATA_ATTACHOBS' {
        ext.args = {
            [
                params.barcode_delimiter ? "--delimiter '${params.barcode_delimiter}' --sample-column sample" : '',
                params.barcode_column && params.barcode_column != 'obs_names'
                    ? "--barcode-column '${params.barcode_column}'" : '',
                params.allow_dtype_change ? '--allow-dtype-change' : '',
            ].findAll { arg -> arg }.join(' ')
        }
        memory = { 8.GB * task.attempt }
    }

    /*
     * Representation steps. Module nf-tests load this file without main.nf, where these params are declared, so
     * every closure must cope with a null param.
     */
    withName: 'SCANPY_.*|ATAC_.*|SNAPATAC2_.*' {
        ext.output_mode   = { params.output_mode ?: 'raw' }
        ext.adata_format  = { params.adata_format ?: 'h5ad' }
        ext.sparse_format = { params.sparse_format ?: 'npz' }
        memory            = { 8.GB * task.attempt }
    }

    withName: 'SCANPY_NORMALIZETOTAL' {
        ext.args = { params.normalize_target_sum ? "--target-sum ${params.normalize_target_sum}" : '' }
    }

    withName: 'SCANPY_HVG' {
        ext.args = {
            [
                params.hvg_flavor ? "--flavor ${params.hvg_flavor}" : '',
                params.hvg_n_top_genes ? "--n-top-genes ${params.hvg_n_top_genes}" : '',
                params.hvg_batch_key ? "--batch-key '${params.hvg_batch_key}'" : '',
            ].findAll { arg -> arg }.join(' ')
        }
    }

    withName: 'SCANPY_PCA' {
        ext.args = {
            [
                params.pca_n_comps ? "--n-comps ${params.pca_n_comps}" : '',
                params.pca_scale ? '--scale --scale-max-value 10' : '',
                params.seed != null ? "--seed ${params.seed}" : '',
            ].findAll { arg -> arg }.join(' ')
        }
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    withName: 'ATAC_TFIDF' {
        ext.args = { params.tfidf_scale_factor ? "--scale-factor ${params.tfidf_scale_factor}" : '' }
    }

    withName: 'ATAC_LSI' {
        ext.args = {
            [
                params.lsi_n_comps ? "--n-comps ${params.lsi_n_comps}" : '',
                params.lsi_drop_first ? '--drop-first' : '',
            ].findAll { arg -> arg }.join(' ')
        }
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    withName: 'SNAPATAC2_SELECTFEATURES' {
        ext.args = {
            [
                params.select_n_features ? "--n-features ${params.select_n_features}" : '',
                params.select_filter_lower_quantile != null
                    ? "--filter-lower-quantile ${params.select_filter_lower_quantile}" : '',
                params.select_filter_upper_quantile != null
                    ? "--filter-upper-quantile ${params.select_filter_upper_quantile}" : '',
            ].findAll { arg -> arg }.join(' ')
        }
        cpus = 4
    }

    withName: 'SNAPATAC2_SPECTRAL' {
        ext.args = {
            [
                params.spectral_n_comps ? "--n-comps ${params.spectral_n_comps}" : '',
                params.spectral_distance_metric ? "--distance-metric ${params.spectral_distance_metric}" : '',
                params.spectral_sample_size ? "--sample-size ${params.spectral_sample_size}" : '',
                params.spectral_weighted_by_sd == false ? '--no-weighted-by-sd' : '',
                params.seed != null ? "--seed ${params.seed}" : '',
            ].findAll { arg -> arg }.join(' ')
        }
        cpus   = 8
        memory = { 16.GB * task.attempt }
    }

    // The v1 methods read h5ad: the assembled object stays h5ad whatever --adata_format says
    withName: 'ANNDATA_ASSEMBLE' {
        memory = { 8.GB * task.attempt }
    }

    // v1 modules: they read the embedding from obsm of the assembled object (meta.embedding_key)
    withName: 'SEACELLS' {
        ext.args = {
            [
                "--type ${meta.assay == 'atac' ? 'atac' : 'gex'}",
                params.seacells_n_metacells ? "--n_metacells ${params.seacells_n_metacells}" : "--gamma ${params.metacell_size}",
                "--n_top_genes ${params.hvg_n_top_genes}",
                "--n_components ${meta.assay == 'atac' ? params.lsi_n_comps : params.pca_n_comps}",
                "--n_waypoint_eigs ${params.seacells_n_waypoint_eigs}",
                "--convergence_epsilon ${params.seacells_convergence_epsilon}",
                "--min_iter ${params.seacells_min_iter}",
                "--max_iter ${params.seacells_max_iter}",
                params.seacells_use_sparse ? '--use_sparse' : '',
                meta.embedding_key ? "--precomputed ${meta.embedding_key}" : '',
                params.eval_labels ? "--celltype_label ${params.eval_labels}" : '',
            ].findAll { arg -> arg }.join(' ')
        }
        // The v1 module's 'docker://' image prefix breaks the Docker engine; Singularity takes the plain name too
        container     = 'quay.io/cellgeni/seacells:latest'
        cpus          = { task.attempt > 1 ? 64 : 16 }
        memory        = { 64.GB * task.attempt }
        queue         = { task.attempt > 3 ? 'hugemem' : 'normal' }
        // v1 SEACells is unseeded and sometimes stops with "Algorithm has not converged"; a rerun usually converges
        errorStrategy = { task.attempt <= 2 || task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    }

    withName: 'HMETACELLS' {
        ext.args = {
            [
                "--type ${meta.assay == 'atac' ? 'atac' : 'gex'}",
                "--n_min ${params.hmetacells_n_min}",
                "--n_max ${params.hmetacells_n_max}",
                "--method ${params.hmetacells_method}",
                "--n_top_genes ${params.hvg_n_top_genes}",
                "--n_components ${meta.assay == 'atac' ? params.lsi_n_comps : params.pca_n_comps}",
                "--n_neighbors ${params.hmetacells_n_neighbors}",
                meta.embedding_key ? "--precomputed ${meta.embedding_key}" : '',
                "--celltype_label ${params.constrain_by}",
            ].findAll { arg -> arg }.join(' ')
        }
        memory = { 64.GB * task.attempt }
    }
}
