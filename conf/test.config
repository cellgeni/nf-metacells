/*
 * Two synthetic RNA samples, SEACells and hmetacells with the 0.1.0 regression-baseline settings.
 * Run from the repository root: nextflow run . -profile test[,local|docker]
 */
params {
    input            = 'tests/data/samplesheet_rna.csv'
    methods          = 'seacells,hmetacells'
    constrain_by     = 'celltype'
    eval_labels      = 'celltype'
    hvg_n_top_genes  = 500
    pca_n_comps      = 30
    lsi_n_comps      = 30
    hmetacells_n_min = 5
    hmetacells_n_max = 30
    hmetacells_method = 'paris'
}

process {
    resourceLimits = [cpus: 2, memory: 8.GB, time: 1.h]
}
