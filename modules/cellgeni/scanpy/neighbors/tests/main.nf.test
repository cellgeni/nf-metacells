nextflow_process {

    name "Test Process SCANPY_NEIGHBORS"
    script "../main.nf"
    process "SCANPY_NEIGHBORS"

    tag "modules"
    tag "scanpy/neighbors"

    test("kNN graph of a PCA raw directory, attached to a zarr copy") {
        config "./neighbors.config"
        setup {
            run("SCANPY_PCA") {
                script "../../pca/main.nf"
                process {
                    """
                    input[0] = record(id: 'S1.rna', adata: file("${projectDir}/tests/data/rna.h5ad", checkIfExists: true),
                                      matrix: null, mask: null, output_prefix: null)
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SCANPY_PCA.out.map { r ->
                    record(id: r.id, adata: file("${projectDir}/tests/data/rna.h5ad"), embedding: r.pca,
                           embedding_key: null, output_prefix: null)
                }
                """
            }
        }
        then {
            def out = process.out[0][0]
            assertAll(
                { assert process.success },
                { assert file(out.neighbors).name == 'S1.rna.neighbors.zarr' },
                { assert file("${out.neighbors}/obsp/connectivities").isDirectory() },
                { assert file("${out.neighbors}/obsp/distances").isDirectory() },
                { assert file("${out.neighbors}/X").isDirectory() }
            )
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = record(id: 'S1.rna', adata: file("${projectDir}/tests/data/rna.h5ad", checkIfExists: true),
                                  embedding: null, embedding_key: null, output_prefix: null)
                """
            }
        }
        then {
            assert process.success
            assert file(process.out[0][0].neighbors).name == 'S1.rna.neighbors.raw'
        }
    }
}
