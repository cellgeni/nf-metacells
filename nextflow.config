/*
 * nf-metacells configuration. Parameters are declared in main.nf (`params {}`) and documented in
 * nextflow_schema.json; only those that config settings use are declared here.
 */

plugins {
    id 'nf-schema@3.1.0'
}

params {
    outdir       = 'results'
    publish_mode = 'copy'

    // GPU: read by the process_gpu settings in conf/base.config
    gpu_steps = 'none'
    gpuqueue  = 'gpu'
    gpu_gmem  = 40000
    costcode  = null
}

outputDir            = params.outdir
workflow.output.mode = params.publish_mode
workDir              = 'nf-work'

nextflow.enable.moduleBinaries = true

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Sanger farm defaults: LSF and Singularity
process.executor = 'lsf'
executor.perJobMemLimit = true

singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = '120m'
    runOptions  = '-B /lustre,/nfs'
    cacheDir    = '/nfs/cellgeni/singularity/images/'
}

profiles {
    local {
        process.executor = 'local'
    }
    docker {
        process.executor    = 'local'
        singularity.enabled = false
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_atac {
        includeConfig 'conf/test_atac.config'
    }
    test_paired {
        includeConfig 'conf/test_paired.config'
    }
    test_10x {
        includeConfig 'conf/test_10x.config'
    }
}

// Run reports in <outdir>/pipeline_info, one set per run
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}

manifest {
    name            = 'cellgeni/nf-metacells'
    contributors    = [
        [
            name        : 'Aljes',
            email       : 'ab76@sanger.ac.uk',
            github      : 'claptar',
            contribution: ['author', 'maintainer'],
        ],
    ]
    homePage        = 'https://github.com/cellgeni/nf-metacells'
    description     = 'Metacells (SEACells, hierarchical) from scRNA-seq and scATAC-seq AnnData'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.10.6'
    version         = 'dev'
}
