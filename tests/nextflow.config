// Configuration for nf-test runs (module and pipeline tests).
// Pick the container engine with `nf-test test ... --profile singularity` (farm) or `--profile docker` (CI).

process {
    resourceLimits = [cpus: 4, memory: 16.GB, time: 2.h]
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = '/nfs/cellgeni/singularity/images/'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}
