process {
    withName: 'ADATA_ATTACHOBS' {
        ext.args   = {
            [
                params.delimiter ? "--delimiter '${params.delimiter}' --sample-column sample" : '',
                params.barcode_column && params.barcode_column != 'obs_names' ? "--barcode-column '${params.barcode_column}'" : '',
                params.allow_dtype_change ? '--allow-dtype-change' : '',
            ].findAll { arg -> arg }.join(' ')
        }
        cpus       = 1
        memory     = { 8.GB * task.attempt }
        queue      = 'normal'
        // adata-cli failures are deterministic (exit 1); retry only when the job was killed
        errorStrategy = { task.exitStatus in (130..145) ? 'retry' : 'finish' }
        publishDir = [
            mode     : params.publish_mode,
            path     : "${params.outdir}/adata/metadata",
            overwrite: true
        ]
    }
}
